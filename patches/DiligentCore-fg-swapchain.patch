+// NUKE PATCH: the back-buffer views hold the DXGI buffers; DXGI allows a second swap chain for a
+// window only once the first is fully released, so the views go, the GPU idles (the deferred
+// releases run) and only then the DXGI object itself.
+void SwapChainD3D12Impl::ReleaseDXGISwapChain()
+{
+    RefCntAutoPtr<IDeviceContext> pDeviceContext = m_wpDeviceContext.Lock();
+    if (pDeviceContext)
+    {
+        pDeviceContext->Flush();
+        DeviceContextD3D12Impl* pImmediateCtxD3D12 = pDeviceContext.RawPtr<DeviceContextD3D12Impl>();
+        for (auto& pRTV : m_pBackBufferRTV)
+            if (pRTV)
+                pImmediateCtxD3D12->UnbindTextureFromFramebuffer(ClassPtrCast<TextureD3D12Impl>(pRTV->GetTexture()), false);
+    }
+    m_pBackBufferRTV.clear();
+    m_pDepthBufferDSV.Release();
+    m_pRenderDevice.RawPtr<RenderDeviceD3D12Impl>()->IdleGPU();
+    m_pSwapChain.Release();
+    // The waitable belonged to the released object; a vendor proxy paces its own presents.
+    m_FrameLatencyWaitableObject = NULL;
+}
+
+void SwapChainD3D12Impl::DetachDXGISwapChain()
+{
+    ReleaseDXGISwapChain();
+}
+
+void SwapChainD3D12Impl::AttachDXGISwapChain(IDXGISwapChain* pSwapChain)
+{
+    ReleaseDXGISwapChain();
+    try
+    {
+        if (pSwapChain)
+        {
+            CHECK_D3D_RESULT_THROW(pSwapChain->QueryInterface(__uuidof(IDXGISwapChain3), reinterpret_cast<void**>(static_cast<IDXGISwapChain3**>(&m_pSwapChain))),
+                                   "The attached swap chain does not expose IDXGISwapChain3");
+        }
+        else
+        {
+            RefCntAutoPtr<IDeviceContext> pDeviceContext = m_wpDeviceContext.Lock();
+            VERIFY(pDeviceContext, "Immediate context has been released");
+            if (!pDeviceContext)
+                return;
+            DeviceContextD3D12Impl* pImmediateCtxD3D12 = pDeviceContext.RawPtr<DeviceContextD3D12Impl>();
+            m_pRenderDevice.RawPtr<RenderDeviceD3D12Impl>()->LockCmdQueueAndRun(
+                pImmediateCtxD3D12->GetCommandQueueId(),
+                [this](ICommandQueueD3D12* pCmdQueue) //
+                {
+                    CreateDXGISwapChain(pCmdQueue->GetD3D12CommandQueue());
+                } //
+            );
+        }
+        InitBuffersAndViews();
+    }
+    catch (const std::runtime_error&)
+    {
+        LOG_ERROR("Failed to attach the swap chain");
+    }
+}
