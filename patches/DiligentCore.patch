diff --git a/Graphics/GraphicsEngineD3D12/src/CommandContext.cpp b/Graphics/GraphicsEngineD3D12/src/CommandContext.cpp
index d572f5ef4..0da954de4 100644
--- a/Graphics/GraphicsEngineD3D12/src/CommandContext.cpp
+++ b/Graphics/GraphicsEngineD3D12/src/CommandContext.cpp
@@ -104,6 +104,38 @@ ID3D12GraphicsCommandList* CommandContext::Close(CComPtr<ID3D12CommandAllocator>
 
     VERIFY_EXPR(m_pCurrentAllocator != nullptr);
     HRESULT hr = m_pCommandList->Close();
+    // NUKE PATCH: name the actual HRESULT + the device-removal reason before the assert.
+    // A Close failure with NO validation error queued = the device was removed
+    // ASYNCHRONOUSLY (GPU fault executing earlier frames) — see the DRED dump in the log.
+    if (FAILED(hr))
+    {
+        CComPtr<ID3D12Device> pd3d12Device;
+        m_pCommandList->GetDevice(__uuidof(pd3d12Device), reinterpret_cast<void**>(&pd3d12Device));
+        const HRESULT RemovedHr = pd3d12Device ? pd3d12Device->GetDeviceRemovedReason() : S_OK;
+        LOG_ERROR_MESSAGE("CommandContext::Close failed: hr=0x", std::hex, static_cast<unsigned long>(hr),
+                          ", device-removed reason=0x", static_cast<unsigned long>(RemovedHr), std::dec,
+                          " (887A0005=REMOVED, 887A0006=HUNG, 887A0007=RESET, 887A0020=DRIVER_INTERNAL, 0=alive)");
+        // The validation text explaining WHY lands in the info queue exactly now — the
+        // per-frame drain never runs again (the assert kills the process), so dump the
+        // whole queue synchronously here.
+        CComPtr<ID3D12InfoQueue> pInfoQueue;
+        if (pd3d12Device && SUCCEEDED(pd3d12Device->QueryInterface(__uuidof(ID3D12InfoQueue),
+                                                                   reinterpret_cast<void**>(&pInfoQueue))))
+        {
+            const UINT64 NumMsgs = pInfoQueue->GetNumStoredMessages();
+            for (UINT64 msg = 0; msg < NumMsgs; ++msg)
+            {
+                SIZE_T MsgLen = 0;
+                pInfoQueue->GetMessage(msg, nullptr, &MsgLen);
+                if (MsgLen == 0) continue;
+                std::vector<char> MsgBuf(MsgLen);
+                D3D12_MESSAGE* pMsg = reinterpret_cast<D3D12_MESSAGE*>(MsgBuf.data());
+                if (SUCCEEDED(pInfoQueue->GetMessage(msg, pMsg, &MsgLen))
+                    && pMsg->Severity <= D3D12_MESSAGE_SEVERITY_WARNING && pMsg->pDescription)
+                    LOG_ERROR_MESSAGE("[D3D12@Close] ", pMsg->pDescription);
+            }
+        }
+    }
     DEV_CHECK_ERR(SUCCEEDED(hr), "Failed to close the command list");
 
     pAllocator = std::move(m_pCurrentAllocator);
