+// NUKE PATCH: hand the VkSwapchainKHR to a vendor (frame generation) without destroying it.
+VkSwapchainKHR SwapChainVkImpl::DetachVkSwapChain()
+{
+    RefCntAutoPtr<IDeviceContext> pDeviceContext  = m_wpDeviceContext.Lock();
+    DeviceContextVkImpl*          pImmediateCtxVk = pDeviceContext ? pDeviceContext.RawPtr<DeviceContextVkImpl>() : nullptr;
+    ReleaseSwapChainResources(pImmediateCtxVk, /*DestroyVkSwapChain=*/false);
+    VkSwapchainKHR vkSwapChain = m_VkSwapChain;
+    m_VkSwapChain              = VK_NULL_HANDLE;
+    m_ImageAcquired            = false;
+    return vkSwapChain;
+}
+
+// NUKE PATCH: adopt a vendor's swap chain (its images are read back through vkGetSwapchainImagesKHR,
+// which the host may have routed through the vendor), or recreate this object's own.
+void SwapChainVkImpl::AttachVkSwapChain(VkSwapchainKHR vkSwapChain)
+{
+    RefCntAutoPtr<IDeviceContext> pDeviceContext = m_wpDeviceContext.Lock();
+    if (!pDeviceContext)
+    {
+        LOG_ERROR_MESSAGE("Immediate context has been released");
+        return;
+    }
+    DeviceContextVkImpl* pImmediateCtxVk = pDeviceContext.RawPtr<DeviceContextVkImpl>();
+    if (m_VkSwapChain != VK_NULL_HANDLE)
+        ReleaseSwapChainResources(pImmediateCtxVk, /*DestroyVkSwapChain=*/true);
+    try
+    {
+        if (vkSwapChain != VK_NULL_HANDLE)
+        {
+            RenderDeviceVkImpl* pRenderDeviceVk = m_pRenderDevice.RawPtr<RenderDeviceVkImpl>();
+            m_VkSwapChain                       = vkSwapChain;
+            uint32_t swapchainImageCount        = 0;
+            VkResult err                        = vkGetSwapchainImagesKHR(pRenderDeviceVk->GetVkDevice(), m_VkSwapChain, &swapchainImageCount, NULL);
+            CHECK_VK_ERROR_AND_THROW(err, "Failed to request the attached swap chain image count");
+            VERIFY_EXPR(swapchainImageCount > 0);
+            if (swapchainImageCount != m_SwapChainDesc.BufferCount)
+            {
+                LOG_INFO_MESSAGE("Attached swap chain with ", swapchainImageCount, " images vs ", m_SwapChainDesc.BufferCount, " before.");
+                m_SwapChainDesc.BufferCount = swapchainImageCount;
+            }
+            NukeCreateSyncObjects(swapchainImageCount);
+        }
+        else
+        {
+            CreateVulkanSwapChain();
+        }
+        InitBuffersAndViews();
+        m_SemaphoreIndex = 0;
+        AcquireNextImage(pImmediateCtxVk);
+    }
+    catch (const std::runtime_error&)
+    {
+        LOG_ERROR("Failed to attach the Vulkan swap chain");
+    }
+}
