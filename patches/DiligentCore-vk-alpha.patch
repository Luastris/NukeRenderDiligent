+    // NUKE PATCH: HDR output — pick an HDR surface format when the host asked for it and the
+    // surface offers one (needs VK_EXT_swapchain_colorspace on the instance). Only formats with
+    // a TEXTURE_FORMAT mapping: the 10-bit ST2084 surface is A2B10G10R10, which Diligent does not
+    // map (its RGB10A2 is A2R10G10B10), so in practice the pick is RGBA16F — ST2084 when offered,
+    // else scRGB linear (what Windows drivers offer for the float format; the host encodes for it).
+    g_NukeVkHDR10Active = false;
+    g_NukeVkHDRScRGB    = false;
+    if (g_NukeVkHDR10)
+    {
+        struct HdrPick { VkFormat Fmt; VkColorSpaceKHR Space; bool ScRGB; };
+        const HdrPick HdrPreference[] = {
+            {VK_FORMAT_A2B10G10R10_UNORM_PACK32, VK_COLOR_SPACE_HDR10_ST2084_EXT, false},
+            {VK_FORMAT_R16G16B16A16_SFLOAT, VK_COLOR_SPACE_HDR10_ST2084_EXT, false},
+            {VK_FORMAT_R16G16B16A16_SFLOAT, VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT, true},
+        };
+        for (const HdrPick& Pref : HdrPreference)
+        {
+            for (const VkSurfaceFormatKHR& SrfFmt : SupportedFormats)
+            {
+                if (SrfFmt.format == Pref.Fmt && SrfFmt.colorSpace == Pref.Space &&
+                    VkFormatToTexFormat(SrfFmt.format) != TEX_FORMAT_UNKNOWN)
+                {
+                    m_VkColorFormat                   = SrfFmt.format;
+                    ColorSpace                        = SrfFmt.colorSpace;
+                    m_SwapChainDesc.ColorBufferFormat = VkFormatToTexFormat(SrfFmt.format);
+                    g_NukeVkHDR10Active               = true;
+                    g_NukeVkHDRScRGB                  = Pref.ScRGB;
+                    break;
+                }
+            }
+            if (g_NukeVkHDR10Active)
+                break;
+        }
+        if (!g_NukeVkHDR10Active)
+        {
+            std::string Offered;
+            for (const VkSurfaceFormatKHR& SrfFmt : SupportedFormats)
+                Offered += " " + std::to_string((int)SrfFmt.format) + "/" + std::to_string((int)SrfFmt.colorSpace);
+            LOG_INFO_MESSAGE("HDR surface format not found; the surface offers (VkFormat/VkColorSpaceKHR):", Offered);
+        }
+    }
